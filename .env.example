# Development API. Keep it loopback-only until a TLS reverse proxy is configured.
BIND_ADDRESS=127.0.0.1:4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supply your own TURN relay for connections across restrictive networks.
# This server sends these ICE settings only after room authentication.
ICE_SERVERS_JSON='[{"urls":"stun:stun.l.google.com:19302"}]'
