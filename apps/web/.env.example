# Public URL of the Rust API, fixed into the browser bundle during build.
NEXT_PUBLIC_API_URL=http://localhost:4000

# AWS API Gateway WebSocket stage URL; omit for the native local Rust server.
# Both public endpoints must be configured before the Vercel build.
# NEXT_PUBLIC_WS_URL=wss://your-api-id.execute-api.us-east-1.amazonaws.com/production
